@startuml GuiSm
title Watch GUI navigation
hide empty description
skinparam backgroundColor #10151d
skinparam state {
    BackgroundColor #26384a
    BorderColor #62cdb0
    FontColor #f2f6fa
    ArrowColor #f2aa48
}

state HOME_CONTEXT
state DIAGNOSTIC_FACE

[*] --> HOME_CONTEXT

HOME_CONTEXT : enter / watch_gui_show_home();
HOME_CONTEXT --> DIAGNOSTIC_FACE : ACTIVATE

DIAGNOSTIC_FACE : enter / watch_gui_show_diagnostic();
DIAGNOSTIC_FACE --> HOME_CONTEXT : ACTIVATE

/'! $CONFIG : toml
[SmRunnerSettings]
transpilerId = "C99"

[RenderConfig]
FileTop = """
    // Generated from statecharts/GuiSm.plantuml. Do not edit by hand.
    """

[RenderConfig.C]
CFileIncludes = """
    #include "watch/gui_state_actions.h"
    """
CEnumDeclarer = "typedef enum __attribute__ ((packed)) {enumName}"
'/
@enduml
