{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsehosense.local/schemas/ui/skin-manifest.v1.json",
  "title": "TsehoSense Skin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "skinId", "version", "minRendererVersion", "supportedProfiles", "requiredSemantics", "budgets"],
  "properties": {
    "format": {"const": "tseho.skin"},
    "formatVersion": {"const": 1},
    "skinId": {"type": "string", "maxLength": 64},
    "version": {"type": "string", "maxLength": 24},
    "minRendererVersion": {"type": "string", "maxLength": 24},
    "supportedProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 64}
    },
    "requiredSemantics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 64}
    },
    "templateVariants": {
      "type": "object",
      "additionalProperties": {"type": "string", "maxLength": 64}
    },
    "modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["normal", "ambient", "high-contrast"]}
    },
    "budgets": {
      "type": "object",
      "required": ["packageBytes", "resourceBytes"],
      "properties": {
        "packageBytes": {"type": "integer", "minimum": 0},
        "resourceBytes": {"type": "integer", "minimum": 0}
      }
    },
    "contentHash": {"type": "string", "maxLength": 128}
  }
}

