{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsehosense.local/schemas/ui/presentation-extension.v1.json",
  "title": "TsehoSense Parameter Presentation Extension v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "visibility": {"enum": ["primary", "secondary", "details", "hidden"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "preferredKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["number", "state", "lamp", "gauge", "bar", "sparkline"]}
    },
    "sizeHint": {"enum": ["auto", "small", "medium", "large", "xlarge"]},
    "group": {"type": "string", "maxLength": 32},
    "precision": {"type": "integer", "minimum": 0, "maximum": 6},
    "showTrend": {"type": "boolean"},
    "passportOrder": {"type": "integer", "minimum": 0, "maximum": 65535}
  }
}

