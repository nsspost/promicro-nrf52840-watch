{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsehosense.local/schemas/ui/display-profile.v1.json",
  "title": "TsehoSense Display Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileId", "shape", "width", "height", "sizeClass", "pixelFormat", "inputs", "safeArea", "budgets"],
  "properties": {
    "profileId": {"type": "string", "minLength": 1, "maxLength": 64},
    "shape": {"enum": ["square", "round", "rectangular"]},
    "width": {"type": "integer", "minimum": 64, "maximum": 8192},
    "height": {"type": "integer", "minimum": 64, "maximum": 8192},
    "sizeClass": {"enum": ["xs", "s", "m", "l", "xl"]},
    "pixelFormat": {"enum": ["mono1", "gray2", "gray4", "rgb565", "rgba8888"]},
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["touch", "crown", "button-back", "buttons", "keyboard", "pointer"]}
    },
    "safeArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": {"type": "integer", "minimum": 0},
        "right": {"type": "integer", "minimum": 0},
        "bottom": {"type": "integer", "minimum": 0},
        "left": {"type": "integer", "minimum": 0}
      }
    },
    "minimumTextPx": {"type": "integer", "minimum": 6},
    "minimumPrimaryTextPx": {"type": "integer", "minimum": 8},
    "minimumHitPx": {"type": "integer", "minimum": 16},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peakRendererRamBytes", "maxDirtyRects", "maxFps"],
      "properties": {
        "framebufferBytes": {"type": "integer", "minimum": 0},
        "peakRendererRamBytes": {"type": "integer", "minimum": 1024},
        "maxDirtyRects": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxFps": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {"type": "boolean"},
          {"type": "number"},
          {"type": "string"}
        ]
      }
    }
  }
}
