{
  "name": "promicro-nrf52840-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Bare-metal watch firmware and debug tools for a ProMicro nRF52840",
  "xpack": {
    "minimumXpmRequired": "0.20.0",
    "devDependencies": {
      "@xpack-dev-tools/arm-none-eabi-gcc": {
        "specifier": "15.2.1-1.1.1",
        "local": "link",
        "platforms": "all"
      },
      "@xpack-dev-tools/openocd": {
        "specifier": "0.12.0-7.1",
        "local": "link",
        "platforms": "all"
      },
      "@xpack-dev-tools/cmake": {
        "specifier": "3.31.9-1.1",
        "local": "link",
        "platforms": "all"
      },
      "@xpack-dev-tools/ninja-build": {
        "specifier": "1.13.1-1.1",
        "local": "link",
        "platforms": "all"
      }
    }
  },
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:gui": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "test:protocol": "node protocol/tseho-link-v0/verify-vectors.mjs",
    "check:embedded": "powershell -ExecutionPolicy Bypass -File scripts/check-embedded-dependencies.ps1",
    "probe": "powershell -ExecutionPolicy Bypass -File scripts/probe.ps1",
    "flash": "powershell -ExecutionPolicy Bypass -File scripts/flash.ps1",
    "flash:watch": "powershell -ExecutionPolicy Bypass -File scripts/flash-pyocd.ps1",
    "flash:pyocd": "powershell -ExecutionPolicy Bypass -File scripts/flash-pyocd.ps1",
    "flash:quick": "powershell -ExecutionPolicy Bypass -File scripts/flash-pyocd.ps1 -TrustCrc",
    "flash:watch:quick": "powershell -ExecutionPolicy Bypass -File scripts/flash-pyocd.ps1 -TrustCrc",
    "reset:watch": "powershell -ExecutionPolicy Bypass -File scripts/reset-pyocd.ps1",
    "diag:watch": "powershell -ExecutionPolicy Bypass -File scripts/diag-pyocd.ps1",
    "log:gadgetbridge": "powershell -ExecutionPolicy Bypass -File scripts/gb-log.ps1",
    "build:gadgetbridge": "powershell -ExecutionPolicy Bypass -File scripts/build-gadgetbridge.ps1",
    "install:gadgetbridge": "powershell -ExecutionPolicy Bypass -File scripts/install-gadgetbridge.ps1",
    "verify-running": "powershell -ExecutionPolicy Bypass -File scripts/verify-running.ps1",
    "verify-ui": "powershell -ExecutionPolicy Bypass -File scripts/verify-ui.ps1",
    "render:strict-host": "powershell -ExecutionPolicy Bypass -File scripts/render-strict-host.ps1",
    "install:pyocd": "uv tool install --python 3.13 pyocd",
    "generate:strict-icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-strict-icons.ps1",
    "generate:strict-font": "powershell -ExecutionPolicy Bypass -File scripts/generate-strict-font.ps1",
    "install:nrf5-sdk": "powershell -ExecutionPolicy Bypass -File scripts/install-nrf5-sdk.ps1",
    "install-jlink": "powershell -ExecutionPolicy Bypass -File scripts/install-jlink.ps1",
    "debug-server": "powershell -ExecutionPolicy Bypass -File scripts/debug-server.ps1",
    "gdb": "powershell -ExecutionPolicy Bypass -File scripts/gdb.ps1"
  }
}
